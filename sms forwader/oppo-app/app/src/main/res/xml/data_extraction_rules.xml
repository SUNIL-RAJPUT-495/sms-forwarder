<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do NOT back up the encrypted preferences file (contains secrets) -->
        <exclude domain="sharedpref" path="sms_forwarder_secure_prefs.xml"/>
        <!-- Do NOT back up the Room database (contains encrypted queue) -->
        <exclude domain="database" path="sms_forwarder_oppo.db"/>
        <exclude domain="database" path="sms_forwarder_oppo.db-shm"/>
        <exclude domain="database" path="sms_forwarder_oppo.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude everything — do not transfer security-sensitive data -->
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
